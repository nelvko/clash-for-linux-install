######################################
#
#   clashctl 全局配置
#   优先级：命令行参数 > 环境变量 > 默认值
#   修改后重开终端或 source 生效
#
######################################

# ================clashsub=============

# 订阅下载：连接超时（秒），用于快速判定订阅服务器不可达
CLASHCTL_SUB_CONNECT_TIMEOUT=5

# 订阅下载：单次尝试总超时（秒）
CLASHCTL_SUB_TIMEOUT=20

# 订阅下载：失败重试次数
CLASHCTL_SUB_RETRY=2

# 订阅下载 UA
CLASHCTL_SUB_UA=clash-verge/v2.4.0

# ───────────────clashnode────────────────────
# 节点延迟测试 URL
CLASHCTL_NODE_DELAY_URL=http://www.gstatic.com/generate_204

CLASHCTL_NODE_DELAY_TIMEOUT=5000
CLASHCTL_NODE_DELAY_CONCURRENCY=8

# 更新来源分支（默认 master；如 dev 为跟进开发版，可能不稳定）
CLASHCTL_UPDATE_BRANCH=

# 自定义更新仓库地址（如 fork 或镜像；设置后不再走 GH_PROXY 前缀拼接）
#CLASHCTL_UPDATE_GIT_URL=https://github.com/yourfork/clash-for-linux-install.git

# GitHub 加速下载代理（更新/依赖下载共用；默认直连，需要时取消注释）
#GH_PROXY=https://gh-proxy.org

# 依赖下载超时时间（秒）
CLASHCTL_DOWNLOAD_TIMEOUT=60

# ── 依赖下载（安装/更新/按需补装/切换内核共用；默认查最新版、失败回退钉版；
#    以下均为可选覆盖）──

# 依赖钉版覆盖：显式设置即生效并跳过最新版查询（内置默认随代码演进，一般无需设置）
#VERSION_MIHOMO=v1.19.27
#VERSION_YQ=v4.53.3
#VERSION_SUBCONVERTER=v0.9.9
#VERSION_UI=v3.20.0

# subconverter 仓库（默认社区版，支持更多协议）
#SUBCONVERTER_REPO=tindy2013/subconverter

# ── 以下由脚本自动生成，用户无需修改 ─────────────────────

# 实际安装的内核
CLASHCTL_KERNEL=

# init 系统类型
INIT_TYPE=

# 安装来源版本（无 .git 目录的安装才有意义；git 安装以 git rev-parse 为准）
CLASHCTL_REV=
